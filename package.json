{
  "name": "introvee-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/copy-static.mjs",
    "deploy": "wrangler pages deploy dist --project-name=introvee-website",
    "deploy:preview": "wrangler pages deploy dist --project-name=introvee-website --branch=preview",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vite": "^7.1.3",
    "wrangler": "^4.124.0"
  }
}
